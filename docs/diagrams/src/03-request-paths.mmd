    classDef redis fill:#FEE2E2,stroke:#EF4444,stroke-width:2.5px,color:#7F1D1D;
    classDef worker fill:#EDE9FE,stroke:#7C3AED,stroke-width:2px,color:#4C1D95;
    classDef proxy fill:#EFF6FF,stroke:#3B82F6,stroke-width:2px,color:#1E3A8A;
    classDef dbprim fill:#DBEAFE,stroke:#2563EB,stroke-width:2.5px,color:#1E3A8A;
    classDef dbrep fill:#CFFAFE,stroke:#0891B2,stroke-width:2px,color:#155E75;
