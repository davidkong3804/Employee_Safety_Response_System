---
title: Cloud Native Architecture · GKE Deployment
---
flowchart LR
    USER["👤 <b>User Browser</b><br/>HTTPS"]:::ext

    subgraph GKE["@@kubernetes|16@@ GKE Cluster · safety-system"]
      direction TB
      ING["@@googlecloud|18@@ <b>GKE Ingress</b> · Cloud LB<br/>Static IP · Managed TLS"]:::edge
      subgraph APP["Application Tier"]
        direction LR
        FE["@@react|20@@@@nginx|18@@ <b>Frontend Pods</b><br/>nginx + React · HPA 2–10"]:::app
        BE["@@fastapi|20@@ <b>Backend Pods</b><br/>FastAPI · NEG · HPA 3–60"]:::appcore
      end
      subgraph DBT["DB Connection Tier"]
        direction LR
        PGB["@@postgresql|18@@ <b>PgBouncer</b> ×3→6<br/>txn pool · 2000→100"]:::proxy
        CSP["@@googlecloud|16@@ <b>cloud-sql-proxy</b> ×2<br/>Workload Identity"]:::proxy
        CSPR["@@googlecloud|16@@ <b>cloud-sql-proxy·replica</b> ×2<br/>read-only"]:::proxy
      end
      subgraph OBS["Observability"]
        direction LR
        PROM["@@prometheus|16@@ <b>Prometheus</b> · 15s"]:::obs
        GRAF["@@grafana|16@@ <b>Grafana</b><br/>16 panels · 5 alerts"]:::obs
      end
    end

    subgraph MNG["🔒 Managed Services · Private IP"]
      direction TB
      MEM["@@redis|21@@ <b>Memorystore Redis</b><br/>write buffer · stats cache · rate-limit"]:::redis
      PRIM["@@postgresql|21@@ <b>Cloud SQL HA · PRIMARY</b><br/>PostgreSQL 16 · Regional"]:::dbprim
      REP["@@postgresql|21@@ <b>Cloud SQL · READ REPLICA</b><br/>safety-db-replica"]:::dbrep
    end

    subgraph CICD["CI / CD"]
      direction TB
      GHA["@@github|16@@ <b>GitHub Actions</b>"]:::ext
      AR["@@googlecloud|15@@ <b>Artifact Registry</b>"]:::ext
    end

    USER -->|HTTPS| ING
    ING -->|"path /"| FE
    ING -->|"path /api/*"| BE
    BE ==>|"① write + drain flush · 5432"| PGB
    PGB --> CSP
    CSP ==>|"TLS · private IP"| PRIM
    BE <==>|"② buffer + stats cache · 6379"| MEM
    BE -.->|"② read miss (5s TTL)"| CSPR
    CSPR --> REP
    PRIM -. "streaming replication" .-> REP
    PROM -->|"/metrics"| BE
    PROM --> GRAF
    GHA -->|"docker push"| AR
    AR -. "image pull" .-> BE

