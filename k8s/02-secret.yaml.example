# TEMPLATE — copy to k8s/02-secret.yaml and fill in REAL values before
# deploying. The real k8s/02-secret.yaml is gitignored, so secrets never
# enter version control.
#
#   cp k8s/02-secret.yaml.example k8s/02-secret.yaml
#   # then edit k8s/02-secret.yaml with real values
#
# Generate a strong JWT secret:
#   openssl rand -hex 32
#
# This .example file has a non-.yaml extension on purpose, so
# `kubectl apply -f k8s/` skips it and only applies the real secret.
#
# For production, prefer GCP Secret Manager + the Secrets Store CSI
# driver (or Sealed Secrets) over a plain Secret object — see
# docs/deployment.md and docs/improvements.md (item D1).
apiVersion: v1
kind: Secret
metadata:
  name: backend-secret
  namespace: safety-system
type: Opaque
stringData:
  JWT_SECRET: "REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32"
  POSTGRES_PASSWORD: "REPLACE_WITH_A_STRONG_DB_PASSWORD"
  # asyncpg URL — the password embedded here MUST match POSTGRES_PASSWORD above.
  DATABASE_URL: "postgresql+asyncpg://app:REPLACE_WITH_A_STRONG_DB_PASSWORD@postgres:5432/safety_response"
